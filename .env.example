# Postgres 连接串（auth 和业务数据同库）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noticount

# better-auth
# 生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 可选，默认从请求推断；生产环境建议显式设置为站点 URL
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth（https://github.com/settings/developers）
# callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 一次性迁移用：Supabase 直连 Postgres 字符串（Settings → Database → Connection string）
# SUPABASE_DB_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

NEXT_PUBLIC_ENV_TYPE=development
